        "The browser URL should include \"/notifications\"",
        "The page title or primary heading should show \"PROFILE\""
      ]
    }
  },
  "route": {
    "path": "/notifications",
    "query": "filter=mention",
    "route_key": "/notifications?filter=mention",
    "page_type": "section"
