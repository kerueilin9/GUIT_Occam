  "gherkin": {
    "feature": "KeystoneJS Content Management",
    "scenario": "Bulk delete multiple posts",
    "given": ["I am logged in as an administrator", "Multiple posts exist"],
    "when": [
      "I navigate to Posts list",
      "I select multiple posts using checkboxes",
      "I click on Delete selected button",
      "I confirm the deletion"
    ],
    "then": [
      "The selected posts should no longer appear in the list"
    ]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["gherkin_criteria"],
    "reference_answers": {
      "gherkin_acceptance_criteria": [
        "The selected posts should no longer appear in the list"
      ]
    }
  }
