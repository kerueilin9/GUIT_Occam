{
  "sites": ["keystonejs"],
  "task_id": "keystonejs_task15",
  "require_login": true,
  "storage_state": ".auth/keystonejs_state.json",
  "start_url": "http://localhost:3100/keystone",
  "geolocation": null,
  "gherkin": {
    "feature": "KeystoneJS Content Management",
    "scenario": "Filter posts by status",
    "given": ["I am logged in as an administrator", "Posts with different statuses exist"],
    "when": [
      "I navigate to Posts list",
      "I select \"Published\" from the status filter"
    ],
    "then": [
      "Only published posts should be displayed",
      "Draft posts should be hidden"
    ]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["gherkin_criteria"],
    "reference_answers": {
      "gherkin_acceptance_criteria": [
        "Only posts with \"Published\" status should be visible",
        "The filter should be applied to the list"
      ]
    }
  }
}
