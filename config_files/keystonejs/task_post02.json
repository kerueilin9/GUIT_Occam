{
  "sites": ["keystonejs"],
  "task_id": "keystonejs_task_post02",
  "require_login": true,
  "storage_state": ".auth/keystonejs_state.json",
  "start_url": "http://localhost:3100/keystone",
  "geolocation": null,
  "gherkin": {
    "feature": "KeystoneJS Content Management",
    "scenario": "Edit an existing post",
    "given": ["I am logged in as an administrator", "A post exists in the system"],
    "when": [
      "I navigate to Posts list",
      "I click on the first post in the list",
      "I update the post title to \"Updated Post Title\"",
      "I save the changes"
    ],
    "then": [
      "I should see a success message"
    ]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["gherkin_criteria"],
    "reference_answers": {
      "gherkin_acceptance_criteria": [
        "A success message should be visible"
      ]
    }
  }
}
