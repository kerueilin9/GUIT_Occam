{
  "sites": ["keystonejs"],
  "task_id": "keystonejs_task_gallery01",
  "require_login": true,
  "storage_state": ".auth/keystonejs_state.json",
  "start_url": "http://localhost:3100/keystone",
  "geolocation": null,
  "gherkin": {
    "feature": "KeystoneJS Content Management",
    "scenario": "Create a new gallery",
    "given": ["I am logged in as an administrator"],
    "when": [
      "I navigate to Gallery list",
      "I click on Create Gallery button",
      "I fill in the gallery title",
      "I fill in the gallery Published Date with \"2023-01-01\"",
      "I save the gallery"
    ],
    "then": [
      "The gallery should be created successfully",
      "I should see a success message"
    ]
  },
  "isp": {
    "enabled": true,
    "max_test_cases": 15,
    "isp_model": "gemini-2.5-flash"
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["gherkin_criteria"],
    "reference_answers": {
      "gherkin_acceptance_criteria": [
        "A success message should be displayed"
      ]
    }
  }
}
