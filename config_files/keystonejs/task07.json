{
  "sites": ["keystonejs"],
  "task_id": "keystonejs_task07",
  "require_login": true,
  "storage_state": ".auth/keystonejs_state.json",
  "start_url": "http://localhost:3100/keystone",
  "geolocation": null,
  "gherkin": {
    "feature": "KeystoneJS Content Management",
    "scenario": "Delete a post",
    "given": ["I am logged in as an administrator", "A post exists in the system"],
    "when": [
      "I navigate to Posts list",
      "I select the first post",
      "I click on Delete button",
      "I confirm the deletion"
    ],
    "then": [
      "The post should be deleted successfully",
      "I should see a success message"
    ]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["string_match", "gherkin_criteria"],
    "reference_answers": {
      "fuzzy_match": "deleted",
      "gherkin_acceptance_criteria": [
        "The post should no longer appear in the list",
        "A success message should be displayed"
      ]
    }
  }
}
