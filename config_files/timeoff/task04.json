{
  "sites": ["timeoff"],
  "task_id": "timeoff_task04",
  "require_login": true,
  "storage_state": ".auth/timeoff_state.json",
  "start_url": "http://localhost:3100",
  "geolocation": null,
  "gherkin": {
    "feature": "TimeOff Navigation",
    "scenario": "Navigate to Staff page",
    "given": ["I am logged in as an employee"],
    "when": ["I click on Employees in the head bar"],
    "then": ["The page should navigate to Staff"]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["string_match", "gherkin_criteria"],
    "reference_answers": {
      "fuzzy_match": "Staff",
      "gherkin_acceptance_criteria": [
        "The page should display Staff",
        "The current URL should contain \"/employees\""
      ]
    }
  }
}
