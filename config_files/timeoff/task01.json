{
  "sites": ["timeoff"],
  "task_id": "timeoff_task01",
  "require_login": true,
  "storage_state": ".auth/timeoff_state.json",
  "start_url": "http://localhost:3100",
  "geolocation": null,
  "gherkin": {
    "feature": "TimeOff Leave Request",
    "scenario": "Submit a new leave request",
    "given": ["I am logged in as an employee"],
    "when": [
      "I navigate to the leave request page",
      "I set start date as \"2025-01-15\"",
      "I set end date as \"2025-01-17\"",
      "I submit the leave request"
    ],
    "then": [
      "The leave request should be created successfully",
      "The status should show as \"Pending\""
    ]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["string_match", "gherkin_criteria"],
    "reference_answers": {
      "fuzzy_match": "new city1",
      "gherkin_acceptance_criteria": [
        "The owner's City should be \"new city1\""
      ]
    }
  }
}
