  "require_login": true,
  "storage_state": ".auth/timeoff_state.json",
  "start_url": "http://localhost:3102",
  "gherkin": {
    "feature": "TimeOff Departments Management",
    "scenario": "Modify Sales department properties",
    "given": [
      "I am logged in as an administrator"
    ],
    "when": [
      "I click Settings in the header",
      "I click Departments",
      "I edit the Sales department",
      "I change the department name to 'Sales1'",
      "I set the allowance to '15'",
      "I check the 'Accrued allowance' checkbox",
      "I save the changes"
    ],
    "then": [
      "The page should display 'Department Sales1 was updated'"
    ]
  },
  "eval": {
    "eval_types": [
      "gherkin_criteria"
    ],
    "reference_answers": {
      "gherkin_acceptance_criteria": [
        "The page should display 'Department Sales1 was updated'"
      ]
    }
  }
