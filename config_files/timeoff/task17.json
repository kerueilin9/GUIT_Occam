  "gherkin": {
    "feature": "TimeOff Staff Management",
    "scenario": "Add a new employee account",
    "given": ["I am logged in as an administrator"],
    "when": [
      "I navigate to the Staff page",
      "I add a new employee",
      "I enter First Name as 'te'",
      "I enter Last Name as 'st'",
      "I enter Email Address as 'test@gmail.com'",
      "I enter Password as 'test'",
      "I save the new employee"
    ],
    "then": [
      "The page should display 'New user account successfully added'",
      "The new employee 'te st' should appear in the staff list",
      "The employee email should be 'test@gmail.com'"
    ]
  },
  "intent_template_id": 0,
  "require_reset": false,
  "eval": {
    "eval_types": ["string_match", "gherkin_criteria"],
    "reference_answers": {
      "fuzzy_match": "New user account successfully added",
      "gherkin_acceptance_criteria": [
        "The page should display 'New user account successfully added'",
        "The employee 'te st' should be visible in the staff list"
      ]
    }
  }
