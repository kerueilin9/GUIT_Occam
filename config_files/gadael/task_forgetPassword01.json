{
  "sites": ["gadael"],
  "task_id": "gadael_forgetPassword01",
  "order": 99,
  "require_login": false,
  "storage_state": ".auth/gadael_state.json",
  "start_url": "http://localhost:3000",
  "gherkin": {
    "feature": "Forget password",
    "scenario": "forget password",
    "given": ["I am on the Welcome Page"],
    "when": [
        "I click the Login button",
        "I click the \"Forgot Password\" link",
        "I fill in 'Email' field with \"user@example.com\"",
        "I click the Send button"
    ],
    "then": [
        "The message \"No user found with email user@example.com\" should appear on the screen"
    ]
  },
  "eval": {
    "eval_types": ["gherkin_criteria"],
    "reference_answers": {
      "gherkin_acceptance_criteria": [
        "The message \"No user found with email user@example.com\" should appear on the screen"
      ]
    }
  }
}


