  "gherkin": {
    "feature": "Gadael Recover Quantity Management",
    "scenario": "Create a recover quantity",
    "given": [
      "I am logged in as a user"
    ],
    "when": [
      "I click the Admin menu",
      "I click Recover quantities",
      "I click Add a recover quantity",
      "I fill in the Name of the event to recover field with \"Event #@$ %^&*()_+=-[]{}|\\\\;:'\\\"<>,./?`~\"",
      "I fill in the Quantity to recover from the event field with \"1\"",
      "I click the Save button"
    ]
  },
  "isp_test_case": {
    "_case_name": "name with special characters",
    "_expected": "pass",
    "Name of the event to recover": {
      "value": "Event #@$ %^&*()_+=-[]{}|\\;:'\"<>,./?`~"
    },
    "Quantity to recover from the event": {
      "value": "1"
    }
  },
  "eval": {
    "eval_types": [
      "llm_judge"
    ]
  }
